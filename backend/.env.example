# Servidor
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL (desarrollo local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventario_db
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# En producción (Vercel) usa esta variable en vez de las de arriba.
# Ejemplo con Neon: postgresql://usuario:password@ep-xxxx.neon.tech/inventario_db?sslmode=require
# DATABASE_URL=

# JWT
JWT_SECRET=cambia_este_secreto_por_uno_seguro_en_produccion
JWT_EXPIRES_IN=8h

# CORS - URL del frontend
FRONTEND_URL=http://localhost:5173
